+// fscrypt keys added with FS_IOC_ADD_ENCRYPTION_KEY belong to the *mounted
+// superblock*: an umount of /data discards them, and the next mount() creates a
+// fresh superblock with an empty key store. Setup_Data_Partition() unmounts
+// /data ("Ensure /data is not mounted as tmpfs") and later remounts it, so the
+// DE keys installed by Decrypt_FBE_DE() can end up on a superblock that is gone.
+// Symptom on this device: /data/system and /data/misc show ciphertext names and
+// /data/system_de/0/spblob becomes unreachable (ENOENT), which makes the FBE
+// credential path fall back to gatekeeper.*.key and report "Unknown password
+// type". Re-install the DE keys at every mount of /data instead.
+#if defined(TW_INCLUDE_CRYPTO) && defined(TW_INCLUDE_FBE)
+static bool FBE_Dir_Has_Plaintext(const char* path, const char* name) {
+	DIR* dir = opendir(path);
+	if (dir == NULL)
+		return false;
+	bool found = false;
+	struct dirent* de;
+	while ((de = readdir(dir)) != NULL) {
+		// plaintext entries that always exist in these dirs;
+		// ciphertext names are ~30-45 chars of base64 and never equal these
+		if (strcmp(de->d_name, name) == 0) {
+			found = true;
+			break;
+		}
+	}
+	closedir(dir);
+	return found;
+}
+
+static bool FBE_DE_Names_Are_Plaintext() {
+	// both keys must be live on the *current* superblock, and they protect
+	// different dirs, so check one marker per key:
+	//   /data/system          -> systemwide DE key (/data/unencrypted/key)
+	//   /data/system_de/0     -> per-user DE key (/data/misc/vold/user_keys/de/0),
+	//                            holds the spblob the credential path needs
+	if (!FBE_Dir_Has_Plaintext("/data/system", "users") &&
+	    !FBE_Dir_Has_Plaintext("/data/system", "packages.xml"))
+		return false;
+	if (TWFunc::Path_Exists("/data/system_de/0") &&
+	    !FBE_Dir_Has_Plaintext("/data/system_de/0", "spblob"))
+		return false;
+	return true;
+}
+
+// Read the live mount state from /proc/mounts: TWRP's Mount_Read_Only flag is
+// only the *intent*, and Update_Size() can leave a probe mount behind.
+static bool Mount_Point_Is_Read_Only(const std::string& point) {
+	FILE* f = fopen("/proc/mounts", "r");
+	if (f == NULL)
+		return false;
+	char dev[256], mp[400], type[64], opts[512];
+	bool ro = false;
+	while (fscanf(f, "%255s %399s %63s %511s %*d %*d\n", dev, mp, type, opts) == 4) {
+		if (point == mp) {
+			ro = (strncmp(opts, "ro,", 3) == 0) || (strcmp(opts, "ro") == 0) ||
+			     (strstr(opts, ",ro") != NULL);
+			break;
+		}
+	}
+	fclose(f);
+	return ro;
+}
+
+void TWPartition::Ensure_Mounted_RW(const char* why) {
+	if (Mount_Read_Only)
+		return;                       // this partition is meant to be read-only
+	if (!Is_Mounted())
+		return;
+	if (!Mount_Point_Is_Read_Only(Mount_Point))
+		return;
+	printf("[de] Ensure_Mounted_RW(%s): %s is ro, remounting rw\n", why, Mount_Point.c_str());
+	fflush(stdout);
+	// keep the partition's own VFS flags (nosuid/nodev/noatime), drop MS_RDONLY
+	unsigned int flags = MS_REMOUNT | (Mount_Flags & ~MS_RDONLY);
+	if (mount(NULL, Mount_Point.c_str(), NULL, flags,
+	          Mount_Options.empty() ? NULL : Mount_Options.c_str()) != 0) {
+		printf("[de] Ensure_Mounted_RW(%s): remount FAILED errno=%d (%s)\n",
+		       why, errno, strerror(errno));
+		fflush(stdout);
+	} else {
+		printf("[de] Ensure_Mounted_RW(%s): remount rw OK\n", why);
+		fflush(stdout);
+	}
+}
+
+void TWPartition::Ensure_FBE_DE_Keys(const char* why) {
+	if (Mount_Point != "/data")
+		return;
+	if (!TWFunc::Path_Exists("/data/unencrypted/key/version"))
+		return;
+	// Decrypt_DE() rewrites /data/unencrypted/{mode,ref,per_boot_ref}, so the
+	// mount has to be writable or the systemwide stage fails with EROFS
+	Ensure_Mounted_RW(why);
+	if (FBE_DE_Names_Are_Plaintext())
+		return;
+	printf("[de] Ensure_FBE_DE_Keys(%s): DE names not plaintext, reinstalling keys\n", why);
+	fflush(stdout);
+	bool ok = android::keystore::Decrypt_DE();
+	printf("[de] Ensure_FBE_DE_Keys(%s): Decrypt_DE=%d names_plaintext=%d\n",
+	       why, ok ? 1 : 0, FBE_DE_Names_Are_Plaintext() ? 1 : 0);
+	fflush(stdout);
+}
