+// instead of deadlocking the whole recovery UI. The Rust shim tolerates this:
+// HalNames::as_vec() iterates 0..len and never dereferences data, and Drop
+// calls freeNames() whose loop body does not run when len == 0.
+char** emptyNames(size_t* len) {
+    *len = 0;
+    return convert({});
