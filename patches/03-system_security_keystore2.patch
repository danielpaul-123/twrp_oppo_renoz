diff --git a/keystore2/src/keystore2_main.rs b/keystore2/src/keystore2_main.rs
index cf2ba04..6d8c127 100644
--- a/keystore2/src/keystore2_main.rs
+++ b/keystore2/src/keystore2_main.rs
@@ -44,6 +44,28 @@ fn main() {
     // Redirect panic messages to logcat.
     panic::set_hook(Box::new(|panic_info| {
         error!("{}", panic_info);
+        // BUILD 13 DIAGNOSTIC -- also write the panic to stderr.
+        //
+        // In normal Android, the `error!` above reaches logcat and that is the
+        // end of it. In a TWRP recovery ramdisk there is no logd, so
+        // android_logger writes into a socket nobody is listening on and the
+        // message is silently discarded. keystore2 then aborts (Rust's
+        // panic=abort path sets no android_set_abort_message, and liblog only
+        // sets one for ANDROID_LOG_FATAL -- see logger_write.cpp:310 -- while
+        // `error!` is Level::Error), so nothing at all was observable.
+        //
+        // Proof that the message was being lost rather than never generated:
+        // crash_count is updated at line 56, so execution certainly reaches
+        // the `info!("Keystore2 is starting.")` at line 50, yet a tag-style
+        // grep of dmesg for "keystore2:" returns 0 lines.
+        //
+        // This service carries `stdio_to_kmsg` in
+        // bootable/recovery/etc/init/keystore2.rc, so fd1/fd2 are dup2'd onto
+        // /dev/kmsg_debug (system/core/init/service_utils.cpp:127 SetupStdio)
+        // and anything printed here lands in dmesg. That makes a panic in this
+        // process diagnosable instead of a bare "received signal 6" every 5 s.
+        // In a normal boot with logd present this is merely redundant.
+        eprintln!("{}", panic_info);
     }));
 
     // Saying hi.
