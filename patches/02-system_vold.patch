+// BUILD 22: expose the legacy keystore 1.0 files to keystore2's legacy migrator.
+//
+// Stock Android on this device runs the legacy keystore 1.0 daemon, which
+// stores keys only as files under /data/misc/keystore/user_0/ and never
+// creates /data/misc/keystore/persistent.sqlite. The recovery starts
+// keystore2 pointed at the scratch directory /tmp/misc/keystore
+// (bootable/recovery/etc/init/keystore2.rc:30), so its LegacyBlobLoader sees
+// an empty store and get_key_entry() answers KEY_NOT_FOUND for the synthetic
+// password key (domain SELINUX, namespace 103) - the "key not found" that
+// stopped user-0 CE decryption.
+//
+// Fix, two halves:
+//   a. legacy_migrator.rs is patched with a LOCKSETTINGS_NAMESPACE (103) ->
+//      AID_SYSTEM (1000) arm so the migrator will load that key instead of
+//      refusing the namespace.
+//   b. this copy makes the legacy files visible to it. The source is only
+//      ever read; remove_keystore_entry() inside check_and_migrate() then
+//      deletes only the /tmp copies, so a stock boot still finds its
+//      original files, and the sqlite the migration writes stays in volatile
+//      /tmp.
+//
+// Must run before the first keystore2 get_key_entry(): the migrator caches
+// STATE_EMPTY permanently once it finds an empty store
+// (legacy_migrator.rs:139-141). Both call sites below are on that path.
+static int copy_legacy_store_entries(const char* src, const char* dst) {
+	DIR* dir = opendir(src);
+	if (!dir)
+		return -1;
+	int copied = 0;
+	struct dirent* ent;
+	while ((ent = readdir(dir)) != NULL) {
+		if (!strcmp(ent->d_name, ".") || !strcmp(ent->d_name, ".."))
+			continue;
+		// The scratch sqlite belongs to the running keystore2; never touch it.
+		if (!strncmp(ent->d_name, "persistent.sqlite", 17))
+			continue;
+		std::string sp = std::string(src) + "/" + ent->d_name;
+		std::string dp = std::string(dst) + "/" + ent->d_name;
+		struct stat st;
+		if (lstat(sp.c_str(), &st) != 0)
+			continue;
+		if (S_ISDIR(st.st_mode)) {
+			if (mkdir(dp.c_str(), 0700) != 0 && errno != EEXIST) {
+				printf("[sp] legacy store mkdir FAILED path=%s errno=%d\n", dp.c_str(), errno);
+				continue;
+			}
+			int sub = copy_legacy_store_entries(sp.c_str(), dp.c_str());
+			if (sub > 0)
+				copied += sub;
+		} else if (S_ISREG(st.st_mode)) {
+			std::string data;
+			if (!android::base::ReadFileToString(sp, &data)) {
+				printf("[sp] legacy store read FAILED path=%s errno=%d\n", sp.c_str(), errno);
+				continue;
+			}
+			if (!android::base::WriteStringToFile(data, dp, 0600)) {
+				printf("[sp] legacy store write FAILED path=%s errno=%d\n", dp.c_str(), errno);
+				continue;
+			}
+			copied++;
+		}
+	}
+	closedir(dir);
+	return copied;
+}
+
+// Called when the store should be visible. Retries until the source is
+// actually readable: on first boot activity /data's DE-protected names are
+// still ciphertext (that is exactly what FBE_DE_Names_Are_Plaintext() reports
+// before Decrypt_DE runs), so a copy attempt before the DE keys are installed
+// sees ENOENT. BUILD 23: only a walk that found user_0 (the keystore layout
+// marker) marks us done - a ciphertext readdir would produce garbage names
+// instead.
+static bool copy_legacy_keystore_store(void) {
+	static bool copied = false;
+	if (copied)
+		return true;
+	const char* src = "/data/misc/keystore";
+	const char* dst = "/tmp/misc/keystore";
+	struct stat st;
+	if (stat(src, &st) != 0) {
+		int e1 = errno;
+		int data_ok = (stat("/data", &st) == 0);
+		int misc_ok = (stat("/data/misc", &st) == 0);
+		printf("[sp] legacy store: %s absent errno=%d (stat /data=%d /data/misc=%d)\n",
+		       src, e1, data_ok, misc_ok);
+		fflush(stdout);
 		return false;
 	}
-	if (!fscrypt_init_user0()) {
-		printf("fscrypt_init_user0 returned fail\n");
+	if (mkdir(dst, 0700) != 0 && errno != EEXIST) {
+		printf("[sp] legacy store: mkdir %s FAILED errno=%d\n", dst, errno);
+		fflush(stdout);
 		return false;
 	}
+	int n = copy_legacy_store_entries(src, dst);
+	std::string marker = std::string(dst) + "/user_0";
+	DIR* d = opendir(marker.c_str());
+	if (d)
+		closedir(d);
+	printf("[sp] legacy store copied %d files from %s (user_0 marker=%d)\n",
+	       n, src, d ? 1 : 0);
+	fflush(stdout);
+	if (!d)
+		return false;
+	copied = true;
 	return true;
 }
 
+extern "C" bool Decrypt_DE() {
+	printf("Attempting to initialize DE keys\n");
+	bool systemwide_ok = fscrypt_initialize_systemwide_keys();
+	if (!systemwide_ok)
+		printf("fscrypt_initialize_systemwide_keys returned fail\n");
+	// Run the per-user stage even when the systemwide stage failed: the failing
+	// part of that stage is the /data/per_boot key, which init regenerates on
+	// every Android boot anyway, while fscrypt_init_user0 installs the per-user
+	// DE key that protects /data/system_de/<user>/spblob. Skipping it makes the
+	// FBE credential path report "Unknown password type" for a correct PIN.
+	bool user0_ok = fscrypt_init_user0();
+	if (!user0_ok)
+		printf("fscrypt_init_user0 returned fail\n");
+	// BUILD 23: copy the legacy store only after both key stages - build 22's
+	// attempt before them hit ENOENT because DE-protected names were still
+	// ciphertext at that point.
+	copy_legacy_keystore_store();
+	fflush(stdout);
+	return systemwide_ok && user0_ok;
+}
